datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  name          String        @unique
  username      String        @unique
  password      String
  avatarAddress String?
  lastSeen      DateTime
  creationTime  DateTime
  participants  Participant[]
  messages      Message[]
  receipt       Receipt[]
}

model Conversation {
  id           String        @id @default(uuid())
  isGroup      Boolean
  name         String? // only set when isGroup = true
  creationTime DateTime
  participants Participant[]
  messages     Message[]
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

//This table is what makes group chat possible and what you check before letting anyone into a room.
model Participant {
  id             String       @id @default(uuid())
  role           Role
  joinTime       DateTime
  // each user perticipate to more then one conversation
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
}

enum Status {
  SENT
  DELIVERED
  READ
}

model Message {
  id                String       @id @default(uuid())
  userId            String
  conversationId    String
  textBody          String?
  attachmentAddress String?
  status            Status
  creationTime      DateTime
  edited            String?
  user              User         @relation(fields: [userId], references: [id])
  conversation      Conversation @relation(fields: [conversationId], references: [id])
  receipt           Receipt[]
}

model Receipt {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  readTime  DateTime
  user      User     @relation(fields: [userId], references: [id])
  message   Message  @relation(fields: [messageId], references: [id])

  @@unique([userId, messageId])
}
