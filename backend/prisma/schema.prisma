datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  name          String        
  username      String        @unique
  passwordHash      String
  avatarAddress String?
  lastSeen      DateTime? // Must be DateTime?, whene i user create accont is never been seen.
  creationTime  DateTime @default(now())
  participants  Participant[]
  messages      Message[]
  receipt       Receipt[]
}

model Conversation {
  id           String        @id @default(uuid())
  isGroup      Boolean @default(false)
  name         String? // only set when isGroup = true
  creationTime DateTime @default(now())
  participants Participant[]
  messages     Message[]
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

//This table is what makes group chat possible and what you check before letting anyone into a room.
model Participant {
  id             String       @id @default(uuid())
  role           Role @default(MEMBER)
  joinTime       DateTime @default(now())
  // each user perticipate to more then one conversation
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  @@unique([userId, conversationId])
}

enum Status {
  SENT
  DELIVERED
  READ
}

model Message {
  id                String       @id @default(uuid())
  userId            String
  conversationId    String
  textBody          String?
  attachmentAddress String?
  status            Status @default(SENT)
  creationTime      DateTime @default(now())
  edited            String?
  user              User         @relation(fields: [userId], references: [id])
  conversation      Conversation @relation(fields: [conversationId], references: [id])
  receipt           Receipt[]
}

model Receipt {
  id        String   @id @default(uuid())
  messageId String
  userId    String 
  readTime  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  message   Message  @relation(fields: [messageId], references: [id])

  @@unique([userId, messageId])
}
