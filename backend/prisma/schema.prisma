datasource db {
  provider = "postgresql"
}

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  username      String         @unique
  passwordHash  String
  avatarAddress String?
  lastSeen      DateTime? // Must be DateTime?, whene i user create accont is never been seen.
  createdAt     DateTime       @default(now())
  participants  Participant[]
  messages      Message[]
  receipt       Receipt[]
  token         RefreshToken[]
}

model Conversation {
  id           String        @id @default(uuid())
  isGroup      Boolean       @default(false)
  name         String? // only set when isGroup = true
  createdAt    DateTime      @default(now())
  participants Participant[]
  messages     Message[]
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

//This table is what makes group chat possible and what you check before letting anyone into a room.
model Participant {
  id             String       @id @default(uuid())
  role           Role         @default(MEMBER)
  joinTime       DateTime     @default(now())
  // each user perticipate to more then one conversation
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String

  @@unique([userId, conversationId])
  @@index([conversationId])
}

enum Status {
  SENT
  DELIVERED
  READ
}

model Message {
  id                String       @id @default(uuid())
  senderId          String
  conversationId    String
  textBody          String?
  attachmentAddress String?
  status            Status       @default(SENT)
  createdAt         DateTime     @default(now())
  editedAt          DateTime?
  deletedAt         DateTime?
  sender            User         @relation(fields: [senderId], references: [id])
  conversation      Conversation @relation(fields: [conversationId], references: [id])
  receipt           Receipt[]

  @@index([conversationId, createdAt(sort: Desc)])
}

model Receipt {
  messageId String
  userId    String
  readTime  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  message   Message  @relation(fields: [messageId], references: [id])

  @@id([messageId, userId])
}

// Strategy: Postgres table — filter by expiry at query time.
// Expired rows are NOT auto-deleted; instead every query includes
//   WHERE expiry > NOW() AND revoked = FALSE
// A periodic job (or a simple DELETE on login) can sweep stale rows.
model RefreshToken {
  token     String   @id // opaque random token (e.g. 32-byte hex)
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  expiry    DateTime // absolute UTC timestamp the token expires
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ownerId]) // fast "all tokens for user X" (logout-all / rotation)
  @@index([expiry]) // fast sweep of expired rows
}
